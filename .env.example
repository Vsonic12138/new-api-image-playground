# Default public demo: no API calls and no real credentials.
VITE_API_MODE=mock

# React runtime:
# mock        = GitHub Pages demo
# relay       = local Vite development proxy (requires NEW_API_TEST_TOKEN)
# standalone  = independent Node BFF (user connects their own token)
# embedded    = NewAPI same-origin login + token-ID selection (requires NewAPI PR)
#
# Vite proxy runs ONLY for local npm run dev. Do not deploy it as a public relay.
NEW_API_BASE_URL=https://your-new-api.example.com
NEW_API_TEST_TOKEN=

# Standalone production backend configuration:
# VITE_API_MODE=standalone npm run build
# NODE_ENV=production UPSTREAM_API_BASE_URL=https://your-new-api.example.com/v1 PORT=3005 HOST=127.0.0.1 npm run start:standalone
# Put the standalone Node server behind an HTTPS reverse proxy.
# NEVER set a NewAPI/admin token as a VITE_* variable.
UPSTREAM_API_BASE_URL=https://your-new-api.example.com/v1
